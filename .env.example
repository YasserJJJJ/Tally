# Site runtime: set through hosting environment variables after API hosting.
API_BASE_URL=http://localhost:8000
# Same value as the backend's API_PROXY_SECRET. Optional locally.
API_PROXY_SECRET=
# Docker Compose local setup; use URL-safe characters for the database password.
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
ALLOWED_ORIGINS=http://localhost:3000,https://tally-weight-journal.yasserj.chatgpt.site
COOKIE_SECURE=false
